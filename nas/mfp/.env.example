# Nur fuer das allererste Login noetig: Wert von __Secure-next-auth.session-token aus einem
# Inkognito-Fenster (F12 -> Application -> Cookies). Danach kann die Zeile geloescht werden,
# die Session lebt in keys/cookies.json und wird vom Keepalive alle 10 min verlaengert.
MFP_COOKIE=

# Zusaetzlich erlaubte Host-Header fuer den HTTP-Transport (kommagetrennt). Ohne die NAS-Adresse
# weist das MCP-SDK LAN-Zugriffe mit 421 "Invalid Host header" ab. Leer = nur localhost.
MFP_ALLOWED_HOSTS=192.168.2.101:*,stevenas:*
